# Telegram
BOT_TOKEN=
ADMIN_ID=

# База данных (при запуске через docker compose DATABASE_URL переопределяется в compose.yaml)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/db
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Мониторинг (необязательно — пустое значение отключает)
# DSN проекта в Sentry
SENTRY_DSN=
# URL пинга dead-man's-switch (healthchecks.io / cronitor)
HEARTBEAT_URL=
# Интервал пинга в минутах (по умолчанию 5)
HEARTBEAT_INTERVAL_MINUTES=5
